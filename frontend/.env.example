# mock: MSW simulates the whole backend and demo run. live: real backend.
# VITE_WS_URL is the stream's base; the client appends /v1/stream.
# .env (tracked) is live; .env.mock is loaded by `vite --mode mock`.
VITE_API_MODE=live
VITE_API_BASE_URL=https://dimensions-comedy-moderate-stat.trycloudflare.com
VITE_WS_URL=wss://dimensions-comedy-moderate-stat.trycloudflare.com
