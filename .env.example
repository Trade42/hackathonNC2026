# Ferry: the single root .env that both ferry-core (backend/) and the messaging sidecar (messaging/) load.
# Copy this file to .env at the repo root and fill in the values. Names only here: never commit .env or a value.

# Supabase Postgres via the Session pooler (Supabase dashboard > Connect > Session pooler, port 5432, password filled in). Never port 6543.
DATABASE_URL=
# Local Postgres 17 for tests: the URL of a local postgres:17 container (or Homebrew postgresql@17). Never the Supabase project.
TEST_DATABASE_URL=
# Supabase project URL: https://ekhaipzpvpyigdtbedvo.supabase.co
SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), from Project Settings > API Keys; sent to clients only through /v1/public/config.
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...), from Project Settings > API Keys; server only, never logged.
SUPABASE_SECRET_KEY=
# Secret that signs Ferry's own JWTs; generate one locally (for example openssl rand -hex 32).
JWT_SECRET=
# Capital One Nessie API key, from the Nessie developer portal (nessieisreal.com).
NESSIE_API_KEY=
# Nessie base URL: whichever of http://api.nessieisreal.com or https://prod-api.nessieisreal.com answers the probe.
NESSIE_BASE_URL=
# live or mock; mock implements the same client in memory, so the demo survives a Nessie outage.
NESSIE_MODE=
# Google Gemini API key, from Google AI Studio.
GEMINI_API_KEY=
# Gemini model name: gemini-3.6-flash, the Flash model that answered the agent's full request fastest (docs/DECISIONS.md, Gemini).
GEMINI_MODEL=
# Photon project id, from the Photon dashboard (app.photon.codes).
PHOTON_PROJECT_ID=
# Photon project secret, from the Photon dashboard (app.photon.codes).
PHOTON_PROJECT_SECRET=
# Base URL where ferry-core reaches the messaging sidecar, for example http://localhost:8787.
SIDECAR_URL=
# Shared secret for the X-Ferry-Secret header between ferry-core and the sidecar; generate one locally.
SIDECAR_SHARED_SECRET=
# Port ferry-core listens on; default 8080. A worktree run sets its own (for example 8110) in the process environment.
PORT=
# Base URL where the messaging sidecar reaches ferry-core; default http://127.0.0.1:8080.
CORE_URL=
# The agent's iMessage number in E.164, from the number connected in the Photon dashboard.
AGENT_PHONE_E164=
# The agent's number formatted for display, derived from AGENT_PHONE_E164, for example (919) 555-0100.
AGENT_PHONE_DISPLAY=
# The web app's public origin, used in deep links; http://localhost:5173 until the frontend deploys.
PUBLIC_WEB_URL=
# The Telegram bot's username (with or without @), for t.me links such as an invite's startgroup link.
TELEGRAM_BOT_USERNAME=
# Web Push VAPID public key; generate the key pair locally (for example npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
# Web Push VAPID private key, from the same generated pair; server only.
VAPID_PRIVATE_KEY=
# true enables demo sign-in, demo top-up, seeding and the runner simulator.
DEMO_MODE=
# DEMO_MODE only: Telegram accounts that sign in as the seeded demo personas, as persona=@username pairs separated by commas (personas judge, maya, dana, leo), for example maya=@maya_demo. Empty means none.
DEMO_TELEGRAM_PERSONAS=
# Optional, DEMO_MODE only: the demo runner simulator's speed multiplier over the runner's walking pace, 0.5 to 100; default 8 (a 1 km walk in about 80 s at brisk pace). A bad value, or any value outside DEMO_MODE, is one warning and the default.
DEMO_SIM_SPEED=
# Sales tax in basis points: a demo estimate, 750 bps.
TAX_RATE_BPS=
# Ferry fee per order in cents: 150.
FERRY_FEE_CENTS=
# Optional (P2): Tiger Cloud connection string for the time-series mirror, from the Tiger Cloud console.
TIGER_DATABASE_URL=
# OSRM routing server for walking routes and car distance; empty means the FOSSGIS server, https://routing.openstreetmap.de. Tests point it at a local stub.
OSRM_BASE_URL=
# Gemini REST API base URL; empty means Google's, https://generativelanguage.googleapis.com. Tests point it at a local stub.
GEMINI_BASE_URL=
# Tests and local runs only: a local stub push service's origin (for example http://127.0.0.1:8291) that Web Push may send to. Ignored unless DATABASE_URL is a local database; leave empty.
PUSH_TEST_STUB_ORIGIN=
# Messaging sidecar: true replies "echo: <text>" to every inbound iMessage without calling ferry-core (the M0 proof); leave empty for normal forwarding.
SIDECAR_ECHO=
# Messaging sidecar: the Telegram bot's token from @BotFather (<bot id>:<secret>). Telegram also needs PHOTON_PROJECT_ID and PHOTON_PROJECT_SECRET: its updates reach the sidecar through Photon's cloud.
SPECTRUM_TELEGRAM_BOT_TOKEN=
# Messaging sidecar: which providers to carry, telegram (default), imessage, or telegram,imessage.
MESSAGING_PROVIDERS=
# Messaging sidecar: the Telegram webhook's secret_token, required with SPECTRUM_TELEGRAM_BOT_TOKEN: 1 to 256 characters of A-Z, a-z, 0-9, _ and - (openssl rand -hex 32). Keep it the same across restarts: Telegram keeps the secret it was first given, and a new one needs deleteWebhook first.
SPECTRUM_TELEGRAM_WEBHOOK_SECRET=
